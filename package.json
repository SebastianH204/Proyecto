{
  "name": "explorador-pokesearch",
  "version": "1.0.0",
  "private": true,
  "description": "Explorador PokeSearch con Tailwind CSS v4 y la PokéAPI",
  "author": "Sebastian Herrera Rueda",
  "scripts": {
    "dev": "tailwindcss -i ./src/entrada.css -o ./css/tailwind.css --watch",
